{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/helion-works/axiom/schemas/a2a-agent-card-minimal.json",
  "title": "A2A AgentCard (minimal, Axiom)",
  "$comment": "Hand-written subset of the A2A AgentCard schema, pinned to A2A specification version 1.0.0 (https://a2a-protocol.org/latest/spec/a2a.json, checked 2026-10-06). Only the fields Axiom validates are described; 'required' follows the REQUIRED field annotations in the spec. Legacy 0.2/0.3 cards (top-level 'url' instead of 'supportedInterfaces') are accepted via anyOf.",
  "type": "object",
  "required": ["name", "description", "version", "capabilities", "defaultInputModes", "defaultOutputModes", "skills"],
  "anyOf": [
    {"required": ["supportedInterfaces"]},
    {"required": ["url"]}
  ],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "version": {"type": "string"},
    "protocolVersion": {"type": "string"},
    "url": {"type": "string"},
    "documentationUrl": {"type": "string"},
    "iconUrl": {"type": "string"},
    "provider": {
      "type": "object",
      "required": ["organization", "url"],
      "properties": {
        "organization": {"type": "string"},
        "url": {"type": "string"}
      }
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "streaming": {"type": "boolean"},
        "pushNotifications": {"type": "boolean"},
        "extendedAgentCard": {"type": "boolean"},
        "supportsAuthenticatedExtendedCard": {"type": "boolean"},
        "extensions": {"type": "array"}
      }
    },
    "defaultInputModes": {"type": "array", "items": {"type": "string"}},
    "defaultOutputModes": {"type": "array", "items": {"type": "string"}},
    "supportedInterfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["url", "protocolBinding"],
        "properties": {
          "url": {"type": "string"},
          "protocolBinding": {"type": "string"},
          "protocolVersion": {"type": "string"},
          "tenant": {"type": "string"}
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "tags"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "description": {"type": "string"},
          "tags": {"type": "array", "items": {"type": "string"}},
          "examples": {"type": "array", "items": {"type": "string"}},
          "inputModes": {"type": "array", "items": {"type": "string"}},
          "outputModes": {"type": "array", "items": {"type": "string"}},
          "securityRequirements": {"type": "array", "items": {"type": "object"}}
        }
      }
    },
    "securitySchemes": {"type": "object", "additionalProperties": {"type": "object"}},
    "securityRequirements": {"type": "array", "items": {"type": "object"}},
    "security": {"type": "array", "items": {"type": "object"}},
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["protected", "signature"],
        "properties": {
          "protected": {"type": "string"},
          "signature": {"type": "string"},
          "header": {"type": "object"}
        }
      }
    }
  }
}
