# ============================================
# Axiom - MCP Security Scanner
# ============================================
# Copy to .env: cp .env.example .env

# --- App ---
APP_NAME=Axiom
APP_ENV=development
# When APP_ENV=production, POST /api/v1/scan/local, /api/v1/discover and
# /api/v1/scan/live/* return 404 unless this is 1, true or yes.
# AXIOM_ALLOW_HOST_ACCESS=0
APP_DEBUG=true
APP_SECRET_KEY=change-this-in-production
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Anthropic Claude API (AI Analysis Engine) ---
# Powers: tool poisoning detection, claimed-vs-actual analysis, prompt injection scoring
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
# Model used by all AI features (scan analysis, `threatmodel --ai`). Optional;
# leave unset to use the default (claude-sonnet-4-20250514).
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- GitHub API (Repo Cloning & Metadata) ---
# Powers: repo health signals, and a higher GitHub API rate limit
# Create at: https://github.com/settings/tokens (scopes: public_repo)
GITHUB_TOKEN=ghp_your-github-personal-access-token

# --- OSV.dev (Vulnerability Database) ---
# Powers: dependency CVE lookups (no key required)
OSV_API_URL=https://api.osv.dev/v1

# --- Logging ---
LOG_LEVEL=INFO

# --- Scan Settings ---
SCAN_TIMEOUT_SECONDS=300
MAX_REPO_SIZE_MB=100
